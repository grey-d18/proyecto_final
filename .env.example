# Copia este archivo como .env y pon tu clave real (el .env está en .gitignore y no se sube).
# La clave de Gemini es GRATIS: se crea en https://aistudio.google.com/apikey (no pide tarjeta).
# Sin clave la app igual funciona: llena la ficha con reglas simples en lugar del LLM.
GEMINI_API_KEY=pon-aqui-tu-clave

# Modelo de Gemini que ordena las respuestas en la ficha
# gemini-3.5-flash-lite responde en ~2 s; gemini-3.5-flash es un poco más preciso pero tarda ~20 s
GEMINI_MODELO=gemini-3.5-flash-lite

# Tamaño del modelo Whisper: tiny, base o small (más grande = más preciso y más lento)
WHISPER_MODELO=base
