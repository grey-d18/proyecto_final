# Copia este archivo como .env y pon tu clave real (el .env está en .gitignore y no se sube).
# Sin clave la app igual funciona: llena la ficha con reglas simples en lugar del LLM.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Claude que ordena las respuestas en la ficha
CLAUDE_MODELO=claude-opus-5-5

# Tamaño del modelo Whisper: tiny, base o small (más grande = más preciso y más lento)
WHISPER_MODELO=base
